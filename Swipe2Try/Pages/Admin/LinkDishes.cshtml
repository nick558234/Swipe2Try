@page
@model Swipe2Try.Pages.Admin.LinkDishesModel
@{
    Layout = "_AdminLayout";
    ViewData["ActivePage"] = "Dishes";
    ViewData["Title"] = "Link Dishes to Restaurants";
}

<div class="flex items-center justify-between mb-6">
    <h3 class="text-gray-700 text-3xl font-medium">Link Dishes to Restaurants</h3>
    <a asp-area="" asp-page="/Admin/Dishes/Index" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded">
        Back to Dishes
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 p-4 rounded-md @(Model.IsSuccess ? "bg-green-100 border-green-400 text-green-700" : "bg-red-100 border-red-400 text-red-700") border">
        @Model.Message
    </div>
}

<div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <h4 class="text-lg font-semibold text-gray-800">Database Setup</h4>
        <p class="text-sm text-gray-600 mt-1">Automatically link all dishes to restaurants based on ownership (same UserId)</p>
    </div>

    <div class="p-6">
        <div class="mb-6">
            <h5 class="text-md font-semibold text-gray-700 mb-2">What this operation does:</h5>
            <ul class="list-disc list-inside text-sm text-gray-600 space-y-1">
                <li>Links dishes to restaurants owned by the same user</li>
                <li>Only creates new links, won't duplicate existing ones</li>
                <li>Updates the dish-restaurant many-to-many relationship table</li>
                <li>Enables users to see which restaurant a dish belongs to</li>
            </ul>
        </div>

        <form method="post">
            <div class="flex items-center justify-between">
                <div>
                    <button type="submit" name="action" value="link" 
                            class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        Link Dishes by Ownership
                    </button>
                </div>
                <div class="text-sm text-gray-500">
                    This operation is safe to run multiple times
                </div>
            </div>
            @Html.AntiForgeryToken()
        </form>

        @if (Model.LinksCreated.HasValue)
        {
            <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-md">
                <h6 class="font-semibold text-blue-800">Operation Results:</h6>
                <p class="text-blue-700 mt-1">
                    @Model.LinksCreated links were created or already existed.
                </p>
            </div>
        }
    </div>
</div>

<div class="mt-6 bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <h4 class="text-lg font-semibold text-gray-800">Current Status</h4>
        <p class="text-sm text-gray-600 mt-1">Overview of dish-restaurant relationships</p>
    </div>

    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-gray-50 p-4 rounded-lg">
                <div class="text-2xl font-bold text-gray-800">@Model.TotalDishes</div>
                <div class="text-sm text-gray-600">Total Dishes</div>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg">
                <div class="text-2xl font-bold text-gray-800">@Model.TotalRestaurants</div>
                <div class="text-sm text-gray-600">Total Restaurants</div>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg">
                <div class="text-2xl font-bold text-gray-800">@Model.TotalLinks</div>
                <div class="text-sm text-gray-600">Dish-Restaurant Links</div>
            </div>
        </div>
    </div>
</div>
