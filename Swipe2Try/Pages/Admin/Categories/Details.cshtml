@page "{id}"
@model Swipe2Try.Pages.Admin.Categories.DetailsModel

@{    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category.Photo)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Category.Photo))
            {
                <img src="@Model.Category.Photo" alt="Category image" style="max-width: 200px; max-height: 200px;" />
            }
            else
            {
                <span>No image</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Category.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
