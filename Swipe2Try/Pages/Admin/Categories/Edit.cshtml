@page "{id}"
@model Swipe2Try.Pages.Admin.Categories.EditModel

@{
	ViewData["Title"] = "Edit Category";
	Layout = "_AdminLayout";
	ViewData["ActivePage"] = "Categories";
}

<div class="container mx-auto px-4 py-8">
	<h1 class="text-2xl font-semibold text-gray-800 mb-6">Edit Category</h1>

	<div class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
		<form method="post">
			<div asp-validation-summary="ModelOnly" class="text-red-500 text-xs italic mb-4"></div>
			<input type="hidden" asp-for="Category.Id"/>

			<div class="mb-4">
				<label asp-for="Category.Name" class="block text-gray-700 text-sm font-bold mb-2"></label>
				<input asp-for="Category.Name" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"/>
				<span asp-validation-for="Category.Name" class="text-red-500 text-xs italic"></span>
			</div>

			<div class="mb-6">
				<label asp-for="Category.Photo" class="block text-gray-700 text-sm font-bold mb-2"></label>
				<input type="text" asp-for="Category.Photo" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-2 leading-tight focus:outline-none focus:shadow-outline"/>
				<span asp-validation-for="Category.Photo" class="text-red-500 text-xs italic"></span>
				@if (!string.IsNullOrEmpty(Model.Category.Photo))
				{
					<div class="mt-4">
						<p class="text-gray-600 text-sm mb-2">Current Image:</p>
						<img src="@Model.Category.Photo" alt="Current category image" class="rounded max-w-xs max-h-48"/>
					</div>
				}
			</div>

			<div class="flex items-center justify-between">
				<input type="submit" value="Save" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline"/>
				<a asp-page="Index" class="inline-block align-baseline font-bold text-sm text-purple-600 hover:text-purple-800">
					Back to List
				</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}