@page
@model Swipe2Try.Pages.SignUpModel
@{
}

<div class="min-h-screen flex flex-col">
	<main class="flex-1 flex items-center justify-center p-4">
		<div class="w-full max-w-md bg-white rounded-lg shadow-sm border border-gray-200 p-8">
			<div class="text-center mb-6">
				<h1 class="text-2xl font-bold">Create your account</h1>
				<p class="text-gray-600 mt-2">Start discovering amazing dishes today</p>
			</div>

			<div class="space-y-4">
				@if (Model.ErrorMessages.Any())
				{
					<div class="bg-red-50 border border-red-200 text-red-800 rounded-md p-4 mb-4">
						<ul class="list-disc pl-5">
							@foreach (var error in Model.ErrorMessages)
							{
								<li>@error</li>
							}
						</ul>
					</div>
				}

				<div class="relative">
					<div class="absolute inset-0 flex items-center">
						<span class="w-full border-t border-gray-200"></span>
					</div>
					<div class="relative flex justify-center text-xs uppercase">
						<span class="bg-white px-2 text-gray-600">Or</span>
					</div>
				</div>

				<form method="post">					<div class="space-y-4">
						<div class="space-y-2">
							<input type="text" asp-for="Input.Name" placeholder="Full Name" class="w-full px-3 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
							@foreach (var error in Model.ErrorMessages.Where(e => e.Contains("Name") || e.Contains("name")))
							{
								<span class="text-red-500 text-sm">@error</span>
							}
						</div>
						<div class="space-y-2">
							<input type="email" asp-for="Input.Email" placeholder="Email" class="w-full px-3 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
							@foreach (var error in Model.ErrorMessages.Where(e => e.Contains("Email") || e.Contains("email")))
							{
								<span class="text-red-500 text-sm">@error</span>
							}
						</div>
						<div class="space-y-2">
							<input type="password" asp-for="Input.Password" placeholder="Password" class="w-full px-3 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
							@foreach (var error in Model.ErrorMessages.Where(e => e.Contains("Password") || e.Contains("password")))
							{
								<span class="text-red-500 text-sm">@error</span>
							}
						</div>
						<div class="space-y-2">
							<select asp-for="Input.Role" asp-items="Model.AvailableRoles" class="w-full px-3 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent">
								<option value="" disabled selected>Select your role</option>
							</select>
							@foreach (var error in Model.ErrorMessages.Where(e => e.Contains("Role") || e.Contains("role")))
							{
								<span class="text-red-500 text-sm">@error</span>
							}
						</div>
						<button type="submit" class="w-full bg-black hover:bg-gray-800 text-white py-3 px-4 rounded-md">
							Sign Up
						</button>
					</div>
				</form>

				<div class="text-center text-sm text-gray-600 mt-6">
					Already have an account?
					<a asp-area="" asp-page="/Login" class="font-medium text-black hover:underline">
						Log in
					</a>
				</div>
			</div>
		</div>
	</main>
</div>

@section Scripts {
	<!-- Client-side validation disabled in favor of server-side validation through UserValidator -->
}