@page
@model Swipe2Try.Pages.swipeModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
}

<div class="container mx-auto px-4 py-8">
	<header class="text-center mb-8">
		<h1 class="text-4xl font-bold text-purple-600">Swipe 'n Try</h1>
		<p class="text-xl text-gray-600 mt-2">Your next meal is just a swipe away.</p>
	</header>

	<div class="max-w-md mx-auto">
		<div id="dish-container" class="relative h-96">
			@if (Model.Dishes.Any())
			{
				@for (int i = 0; i < Model.Dishes.Count; i++)
				{
					var dish = Model.Dishes[i];
					var zIndex = Model.Dishes.Count - i;
					<div class="dish-card absolute inset-0 bg-white rounded-lg shadow-xl overflow-hidden cursor-grab transition-transform duration-300" 
						 data-dish-id="@dish.Id" 
						 style="z-index: @zIndex; transform: scale(@(1 - i * 0.02)) translateY(@(i * 4)px);">
						@if (!string.IsNullOrEmpty(dish.Photo))
						{
							<img src="@dish.Photo" alt="@dish.Name" class="w-full h-64 object-cover">
						}
						else
						{
							<div class="w-full h-64 bg-gray-200 flex items-center justify-center">
								<span class="text-gray-500">No Image</span>
							</div>
						}
						<div class="p-4">
							<h2 class="text-2xl font-bold text-gray-800">@dish.Name</h2>
							@if (!string.IsNullOrEmpty(dish.Restaurant))
							{
								<p class="text-gray-600 text-sm mb-2">@dish.Restaurant</p>
							}
							<p class="text-gray-700 mb-3">@dish.Description</p>
							<div class="flex justify-between items-center">
								<div class="flex items-center">
									@if (dish.HealthFactor.HasValue)
									{
										<span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Health: @dish.HealthFactor/5</span>
									}
								</div>
							</div>
						</div>
						<div class="flex justify-around p-4 bg-gray-50">
							<button class="dislike-btn bg-white hover:bg-red-100 text-red-500 border border-red-500 font-bold p-3 rounded-full shadow-md transition">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
								</svg>
							</button>
							<button class="like-btn bg-white hover:bg-green-100 text-green-500 border border-green-500 font-bold p-3 rounded-full shadow-md transition">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
								</svg>
							</button>
						</div>
					</div>
				}
			}
			else
			{
				<div class="text-center p-8 bg-white rounded-lg shadow-md">
					<h2 class="text-2xl font-bold text-purple-600">No dishes available</h2>
					<p class="text-gray-600 mt-2">Check back later for recommendations.</p>
				</div>
			}
		</div>

		<!-- Counter showing remaining dishes -->
		<div class="text-center mt-4">
			<span id="dish-counter" class="text-sm text-gray-600">@Model.Dishes.Count dishes remaining</span>
		</div>
		<!-- Instructions -->
		<div class="text-center mt-6 text-sm text-gray-500">
			<p>👈 Swipe left to dislike • 👉 Swipe right to like</p>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    let currentDishIndex = 0;
    const dishes = document.querySelectorAll('.dish-card');
    const dishCounter = document.getElementById('dish-counter');
    let totalDishes = dishes.length;

    function updateCounter() {
        const remaining = totalDishes - currentDishIndex;
        dishCounter.textContent = `${remaining} dishes remaining`;
    }    function animateCardOut(card, direction) {
        card.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
        
        let transform = '';
        if (direction === 'right') {
            transform = 'translateX(100vw) rotate(30deg)';
        } else if (direction === 'left') {
            transform = 'translateX(-100vw) rotate(-30deg)';
        }
        
        card.style.transform = transform;
        card.style.opacity = '0';
        
        setTimeout(() => {
            card.style.display = 'none';
            currentDishIndex++;
            updateCounter();
            
            if (currentDishIndex >= totalDishes) {
                showNoMoreDishes();
            }
        }, 300);
    }

    function showNoMoreDishes() {
        const container = document.getElementById('dish-container');
        container.innerHTML = `
            <div class="text-center p-8 bg-white rounded-lg shadow-md">
                <h2 class="text-2xl font-bold text-purple-600">All done!</h2>
                <p class="text-gray-600 mt-2">You've swiped through all available dishes.</p>
                <button onclick="location.reload()" class="mt-4 bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                    Load More Dishes
                </button>
            </div>
        `;
    }    function handleSwipe(card, direction) {
        const dishId = card.dataset.dishId;
        const isLike = direction === 'right';
        
        // Here you could send the preference to the server
        console.log(`${isLike ? 'Liked' : 'Disliked'} dish ID: ${dishId}`);
        
        animateCardOut(card, direction);
    }

    // Touch/mouse event handling for swipe gestures
    dishes.forEach(card => {
        let startX = 0, startY = 0;
        let currentX = 0, currentY = 0;
        let isDragging = false;

        // Mouse events
        card.addEventListener('mousedown', startDrag);
        document.addEventListener('mousemove', drag);
        document.addEventListener('mouseup', endDrag);

        // Touch events
        card.addEventListener('touchstart', startDrag);
        document.addEventListener('touchmove', drag);
        document.addEventListener('touchend', endDrag);        function startDrag(e) {
            if (card.style.display === 'none' || dishes[currentDishIndex] !== card) return;
            
            isDragging = true;
            card.style.transition = 'none';
            
            const clientX = e.type === 'mousedown' ? e.clientX : e.touches[0].clientX;
            
            startX = clientX;
            currentX = clientX;
        }function drag(e) {
            if (!isDragging || card.style.display === 'none' || dishes[currentDishIndex] !== card) return;
            
            e.preventDefault();
            
            const clientX = e.type === 'mousemove' ? e.clientX : e.touches[0].clientX;
            
            currentX = clientX;
            
            const deltaX = currentX - startX;
            const rotation = deltaX * 0.1;
            
            card.style.transform = `translate(${deltaX}px, 0px) rotate(${rotation}deg)`;
            
            // Visual feedback
            const opacity = Math.max(0.5, 1 - Math.abs(deltaX) / 200);
            card.style.opacity = opacity;
        }        function endDrag(e) {
            if (!isDragging || card.style.display === 'none' || dishes[currentDishIndex] !== card) return;
            
            isDragging = false;
            
            const deltaX = currentX - startX;
            const threshold = 100;
            
            if (Math.abs(deltaX) > threshold) {
                handleSwipe(card, deltaX > 0 ? 'right' : 'left');
            } else {
                // Snap back to center
                card.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
                card.style.transform = `scale(${1 - currentDishIndex * 0.02}) translateY(${currentDishIndex * 4}px)`;
                card.style.opacity = '1';
            }
        }

        // Button click handlers
        const likeBtn = card.querySelector('.like-btn');
        const dislikeBtn = card.querySelector('.dislike-btn');
        
        likeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (dishes[currentDishIndex] === card) {
                handleSwipe(card, 'right');
            }
        });
        
        dislikeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (dishes[currentDishIndex] === card) {
                handleSwipe(card, 'left');
            }
        });
    });    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
        if (currentDishIndex >= totalDishes) return;
        
        const currentCard = dishes[currentDishIndex];
        
        switch(e.key) {
            case 'ArrowRight':
            case ' ':
                handleSwipe(currentCard, 'right');
                break;
            case 'ArrowLeft':
            case 'Backspace':
                handleSwipe(currentCard, 'left');
                break;
        }
    });

    updateCounter();
});
</script>