@page
@model Swipe2Try.Pages.swipeModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
}

<div class="container mx-auto px-4 py-8">
	<header class="text-center mb-8">
		<h1 class="text-4xl font-bold text-purple-600">Swipe 'n Try</h1>
		<p class="text-xl text-gray-600 mt-2">Your next meal is just a swipe away.</p>
	</header>
	<div class="max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl mx-auto relative px-2 sm:px-4 md:px-0">
		<!-- Left Dislike Button -->
		<button id="left-dislike-btn"
			class="absolute left-[-50px] sm:left-[-70px] md:left-[-80px] lg:left-[-90px] xl:left-[-100px] top-1/2 transform -translate-y-1/2 z-10 bg-red-500 hover:bg-red-600 text-white font-bold p-2 sm:p-3 md:p-4 rounded-full shadow-lg transition-all duration-200 hover:scale-110">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 md:h-7 md:w-7 lg:h-8 lg:w-8"
				fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<!-- Right Like Button -->
		<button id="right-like-btn"
			class="absolute right-[-50px] sm:right-[-70px] md:right-[-80px] lg:right-[-90px] xl:right-[-100px] top-1/2 transform -translate-y-1/2 z-10 bg-green-500 hover:bg-green-600 text-white font-bold p-2 sm:p-3 md:p-4 rounded-full shadow-lg transition-all duration-200 hover:scale-110">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 md:h-7 md:w-7 lg:h-8 lg:w-8"
				fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
					d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.4 0 00-6.364 0z" />
			</svg>
		</button>

		<div id="dish-container" class="relative min-h-[400px] max-h-[80vh]">
			@if (Model.Dishes.Any())
			{
				@for (int i = 0; i < Model.Dishes.Count; i++)
				{
					var dish = Model.Dishes[i];
					var zIndex = Model.Dishes.Count - i;
					<div class="dish-card absolute inset-0 bg-white rounded-lg shadow-xl overflow-hidden cursor-grab transition-transform duration-300 flex flex-col max-h-full"
						data-dish-id="@dish.Id"
						style="z-index: @zIndex; transform: scale(@(1 - i * 0.02)) translateY(@(i * 4)px);">
						@if (!string.IsNullOrEmpty(dish.Photo))
						{
							<img src="@dish.Photo" alt="@dish.Name"
								class="w-full h-40 sm:h-48 md:h-52 lg:h-56 xl:h-60 object-cover flex-shrink-0">
						}
						else
						{
							<div
								class="w-full h-40 sm:h-48 md:h-52 lg:h-56 xl:h-60 bg-gray-200 flex items-center justify-center flex-shrink-0">
								<span class="text-gray-500 text-sm">No Image</span>
							</div>
						}
						<div class="p-3 sm:p-4 flex flex-col flex-1 justify-between min-h-0">
							<div class="flex-1 min-h-0">
								<h2 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-800 mb-2">@dish.Name</h2>
								@if (!string.IsNullOrEmpty(dish.Restaurant))
								{
									<p class="text-gray-600 text-sm mb-2">@dish.Restaurant</p>
								}
								<p class="text-gray-700 text-sm md:text-base mb-3 line-clamp-2">@dish.Description</p>

								@if (dish.HealthFactor.HasValue)
								{
									<div class="p-2 sm:p-3 bg-gray-50 rounded-lg">
										<div class="flex items-center justify-between mb-2">
											<span class="text-sm font-semibold text-gray-800">Health Rating:</span>
											<div class="flex items-center space-x-1">
												@for (int star = 1; star <= 5; star++)
												{
													@if (star <= Math.Min(dish.HealthFactor.Value, 5))
													{
														<svg class="w-4 h-4 sm:w-5 sm:h-5 text-green-500" fill="currentColor"
															viewBox="0 0 20 20">
															<path
																d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
														</svg>
													}
													else
													{
														<svg class="w-4 h-4 sm:w-5 sm:h-5 text-gray-300" fill="currentColor"
															viewBox="0 0 20 20">
															<path
																d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
														</svg>
													}
												}
												<span class="ml-2 text-sm font-bold text-gray-700">@dish.HealthFactor/10</span>
											</div>
										</div>
										<div class="text-center">
											@{
												string healthText = dish.HealthFactor.Value switch
												{
													<= 2 => "Low Health",
													<= 4 => "Fair Health",
													<= 6 => "Good Health",
													<= 8 => "Very Healthy",
													<= 10 => "Super Healthy",
													_ => "Excellent Health"
												};
												string healthColor = dish.HealthFactor.Value switch
												{
													<= 2 => "text-red-600 bg-red-100",
													<= 4 => "text-orange-600 bg-orange-100",
													<= 6 => "text-yellow-600 bg-yellow-100",
													<= 8 => "text-green-600 bg-green-100",
													<= 10 => "text-green-700 bg-green-100",
													_ => "text-emerald-700 bg-emerald-100"
												};
											}
											<span class="text-xs sm:text-sm font-semibold @healthColor px-2 py-1 rounded-full">
												@healthText
											</span>
										</div>
									</div>
								}
								else
								{
									<div class="p-2 sm:p-3 bg-gray-50 rounded-lg text-center">
										<span class="text-xs sm:text-sm text-gray-500 bg-gray-200 px-2 py-1 rounded-full">
											Health
											rating not available
										</span>
									</div>
								}
							</div>

							<div class="flex justify-around pt-3 border-t border-gray-100 mt-3">
								<button
									class="dislike-btn bg-white hover:bg-red-100 text-red-500 border border-red-500 font-bold p-2 sm:p-3 rounded-full shadow-md transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none"
										viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
											d="M6 18L18 6M6 6l12 12" />
									</svg>
								</button>
								<button
									class="like-btn bg-white hover:bg-green-100 text-green-500 border border-green-500 font-bold p-2 sm:p-3 rounded-full shadow-md transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none"
										viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
											d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
									</svg>
								</button>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="text-center p-8 bg-white rounded-lg shadow-md">
					<h2 class="text-2xl font-bold text-purple-600">No dishes available</h2>
					<p class="text-gray-600 mt-2">Check back later for recommendations.</p>
				</div>
			}
		</div>

		<!-- Counter showing remaining dishes -->
		<div class="text-center mt-4">
			<span id="dish-counter" class="text-sm text-gray-600">@Model.Dishes.Count dishes remaining</span>
		</div>
		<!-- Instructions -->
		<div class="text-center mt-6 text-sm text-gray-500">
			<p>👈 Swipe left to dislike • 👉 Swipe right to like</p>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		let currentDishIndex = 0;
		const dishes = document.querySelectorAll('.dish-card');
		const dishCounter = document.getElementById('dish-counter');
		let totalDishes = dishes.length;
		function updateCounter() {
			const remaining = totalDishes - currentDishIndex;
			dishCounter.textContent = `${remaining} dishes remaining`;
		}

		function animateCardOut(card, direction) {
			card.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';

			let transform = '';
			if (direction === 'right') {
				transform = 'translateX(100vw) rotate(30deg)';
			} else if (direction === 'left') {
				transform = 'translateX(-100vw) rotate(-30deg)';
			}

			card.style.transform = transform;
			card.style.opacity = '0';

			setTimeout(() => {
				card.style.display = 'none';
				currentDishIndex++;
				updateCounter();

				if (currentDishIndex >= totalDishes) {
					showNoMoreDishes();
				}
			}, 300);
		}

		function showNoMoreDishes() {
			const container = document.getElementById('dish-container');
			const leftBtn = document.getElementById('left-dislike-btn');
			const rightBtn = document.getElementById('right-like-btn');

			// Hide side buttons
			leftBtn.style.display = 'none';
			rightBtn.style.display = 'none';

			container.innerHTML = `
            <div class="text-center p-8 bg-white rounded-lg shadow-md">
                <h2 class="text-2xl font-bold text-purple-600">All done!</h2>
                <p class="text-gray-600 mt-2">You've swiped through all available dishes.</p>
                <button onclick="location.reload()" class="mt-4 bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                    Load More Dishes
                </button>
            </div>
        `;
		}

		function handleSwipe(card, direction) {
			const dishId = card.dataset.dishId;
			const isLike = direction === 'right';

			// Here you could send the preference to the server
			console.log(`${isLike ? 'Liked' : 'Disliked'} dish ID: ${dishId}`);

			animateCardOut(card, direction);
		}

		// Touch/mouse event handling for swipe gestures
		dishes.forEach(card => {
			let startX = 0, startY = 0;
			let currentX = 0, currentY = 0;
			let isDragging = false;

			// Mouse events
			card.addEventListener('mousedown', startDrag);
			document.addEventListener('mousemove', drag);
			document.addEventListener('mouseup', endDrag);			// Touch events
			card.addEventListener('touchstart', startDrag);
			document.addEventListener('touchmove', drag);
			document.addEventListener('touchend', endDrag);

			function startDrag(e) {
				if (card.style.display === 'none' || dishes[currentDishIndex] !== card) return;

				isDragging = true;
				card.style.transition = 'none';

				const clientX = e.type === 'mousedown' ? e.clientX : e.touches[0].clientX;

				startX = clientX;
				currentX = clientX;
			}

			function drag(e) {
				if (!isDragging || card.style.display === 'none' || dishes[currentDishIndex] !== card) return;

				e.preventDefault();

				const clientX = e.type === 'mousemove' ? e.clientX : e.touches[0].clientX;

				currentX = clientX;

				const deltaX = currentX - startX;
				const rotation = deltaX * 0.1;

				card.style.transform = `translate(${deltaX}px, 0px) rotate(${rotation}deg)`;

				// Visual feedback
				const opacity = Math.max(0.5, 1 - Math.abs(deltaX) / 200);
				card.style.opacity = opacity;
			}

			function endDrag(e) {
				if (!isDragging || card.style.display === 'none' || dishes[currentDishIndex] !== card) return;

				isDragging = false;

				const deltaX = currentX - startX;
				const threshold = 100;

				if (Math.abs(deltaX) > threshold) {
					handleSwipe(card, deltaX > 0 ? 'right' : 'left');
				} else {
					// Snap back to center
					card.style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
					card.style.transform = `scale(${1 - currentDishIndex * 0.02}) translateY(${currentDishIndex * 4}px)`;
					card.style.opacity = '1';
				}
			}

			// Button click handlers
			const likeBtn = card.querySelector('.like-btn');
			const dislikeBtn = card.querySelector('.dislike-btn');

			likeBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				if (dishes[currentDishIndex] === card) {
					handleSwipe(card, 'right');
				}
			});

			dislikeBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				if (dishes[currentDishIndex] === card) {
					handleSwipe(card, 'left');
				}
			});
		});

		// Side button event handlers
		const leftDislikeBtn = document.getElementById('left-dislike-btn');
		const rightLikeBtn = document.getElementById('right-like-btn');

		leftDislikeBtn?.addEventListener('click', () => {
			if (currentDishIndex < totalDishes) {
				const currentCard = dishes[currentDishIndex];
				handleSwipe(currentCard, 'left');
			}
		});

		rightLikeBtn?.addEventListener('click', () => {
			if (currentDishIndex < totalDishes) {
				const currentCard = dishes[currentDishIndex];
				handleSwipe(currentCard, 'right');
			}
		});

		// Keyboard shortcuts
		document.addEventListener('keydown', (e) => {
			if (currentDishIndex >= totalDishes) return;

			const currentCard = dishes[currentDishIndex];

			switch (e.key) {
				case 'ArrowRight':
				case ' ':
					handleSwipe(currentCard, 'right');
					break;
				case 'ArrowLeft':
				case 'Backspace':
					handleSwipe(currentCard, 'left');
					break;
			}
		});
		updateCounter();

		// Function to adjust container height based on current card
		function adjustContainerHeight() {
			const container = document.getElementById('dish-container');
			const currentCard = dishes[currentDishIndex];

			if (currentCard && currentCard.style.display !== 'none') {
				// Reset any inline height styles on cards
				currentCard.style.height = 'auto';

				// Get the natural height of the current card
				const cardHeight = currentCard.scrollHeight;

				// Set container height to fit the card with some padding
				const containerHeight = Math.min(cardHeight, window.innerHeight * 0.8);
				container.style.height = `${containerHeight}px`;
			}
		}
		// Adjust height on load and resize
		adjustContainerHeight();
		window.addEventListener('resize', adjustContainerHeight);

		// Adjust height when switching cards - using a wrapper function to avoid recursion
		const originalHandleSwipe = handleSwipe;
		handleSwipe = function (card, direction) {
			originalHandleSwipe(card, direction);
			setTimeout(adjustContainerHeight, 100);
		};
	});
</script>