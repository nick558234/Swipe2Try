@page
@model Swipe2Try.Pages.PreferencesModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "My Preferences";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container mx-auto px-4 py-8">
    <header class="text-center mb-8">
        <h1 class="text-4xl font-bold text-purple-600">My Dish Preferences</h1>
        <p class="text-xl text-gray-600 mt-2">Your liked and disliked dishes</p>
    </header>

    <!-- Navigation Tabs -->
    <div class="flex justify-center mb-8">
        <div class="bg-gray-100 p-1 rounded-lg">
            <button id="liked-tab" class="tab-button px-6 py-2 rounded-md font-medium transition-colors active" onclick="showTab('liked')">
                ❤️ Liked (@Model.LikedDishes.Count)
            </button>
            <button id="disliked-tab" class="tab-button px-6 py-2 rounded-md font-medium transition-colors" onclick="showTab('disliked')">
                👎 Disliked (@Model.DislikedDishes.Count)
            </button>
        </div>
    </div>

    <!-- Liked Dishes Section -->
    <div id="liked-section" class="tab-content">
        @if (Model.LikedDishes.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var item in Model.LikedDishes)
                {
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300" data-dish-id="@item.Dish.Id">
                        @if (!string.IsNullOrEmpty(item.Dish.Photo))
                        {
                            <img src="@item.Dish.Photo" alt="@item.Dish.Name" class="w-full h-48 object-cover">
                        }
                        else
                        {
                            <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                                <span class="text-gray-500 text-sm">No Image</span>
                            </div>
                        }
                        
                        <div class="p-4">
                            <div class="flex items-start justify-between mb-2">
                                <h3 class="text-lg font-bold text-gray-800 line-clamp-1">@item.Dish.Name</h3>
                                <span class="text-green-500 text-xl ml-2">❤️</span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(item.Dish.Restaurant))
                            {
                                <p class="text-sm text-gray-600 mb-2">@item.Dish.Restaurant</p>
                            }
                            
                            <p class="text-gray-700 text-sm mb-3 line-clamp-2">@item.Dish.Description</p>
                            
                            @if (item.Dish.HealthFactor.HasValue)
                            {
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-xs font-semibold text-gray-700">Health Rating:</span>
                                    <div class="flex items-center space-x-1">
                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            @if (star <= Math.Min(item.Dish.HealthFactor.Value, 5))
                                            {
                                                <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3 h-3 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                            }
                                        }
                                        <span class="ml-1 text-xs font-bold text-gray-700">@item.Dish.HealthFactor/10</span>
                                    </div>
                                </div>
                            }
                            
                            <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
                                <span>Liked: @item.Preference.CreatedAt.ToString("MMM dd, yyyy")</span>
                                @if (item.Preference.UpdatedAt.HasValue)
                                {
                                    <span>Updated: @item.Preference.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                                }
                            </div>
                            
                            <div class="flex gap-2">
                                <button onclick="removePreference(@item.Dish.Id, this)" 
                                        class="flex-1 bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors">
                                    Remove
                                </button>
                                <a href="/swipe" class="flex-1 bg-purple-500 hover:bg-purple-600 text-white text-xs font-bold py-2 px-3 rounded text-center transition-colors">
                                    Rate Again
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <div class="text-6xl mb-4">😔</div>
                <h3 class="text-2xl font-bold text-gray-700 mb-2">No liked dishes yet</h3>
                <p class="text-gray-600 mb-6">Start swiping to find dishes you love!</p>
                <a href="/swipe" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
                    Start Swiping
                </a>
            </div>
        }
    </div>

    <!-- Disliked Dishes Section -->
    <div id="disliked-section" class="tab-content hidden">
        @if (Model.DislikedDishes.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var item in Model.DislikedDishes)
                {
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300" data-dish-id="@item.Dish.Id">
                        @if (!string.IsNullOrEmpty(item.Dish.Photo))
                        {
                            <img src="@item.Dish.Photo" alt="@item.Dish.Name" class="w-full h-48 object-cover opacity-75">
                        }
                        else
                        {
                            <div class="w-full h-48 bg-gray-200 flex items-center justify-center opacity-75">
                                <span class="text-gray-500 text-sm">No Image</span>
                            </div>
                        }
                        
                        <div class="p-4">
                            <div class="flex items-start justify-between mb-2">
                                <h3 class="text-lg font-bold text-gray-800 line-clamp-1">@item.Dish.Name</h3>
                                <span class="text-red-500 text-xl ml-2">👎</span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(item.Dish.Restaurant))
                            {
                                <p class="text-sm text-gray-600 mb-2">@item.Dish.Restaurant</p>
                            }
                            
                            <p class="text-gray-700 text-sm mb-3 line-clamp-2">@item.Dish.Description</p>
                            
                            @if (item.Dish.HealthFactor.HasValue)
                            {
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-xs font-semibold text-gray-700">Health Rating:</span>
                                    <div class="flex items-center space-x-1">
                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            @if (star <= Math.Min(item.Dish.HealthFactor.Value, 5))
                                            {
                                                <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-3 h-3 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                </svg>
                                            }
                                        }
                                        <span class="ml-1 text-xs font-bold text-gray-700">@item.Dish.HealthFactor/10</span>
                                    </div>
                                </div>
                            }
                            
                            <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
                                <span>Disliked: @item.Preference.CreatedAt.ToString("MMM dd, yyyy")</span>
                                @if (item.Preference.UpdatedAt.HasValue)
                                {
                                    <span>Updated: @item.Preference.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                                }
                            </div>
                            
                            <div class="flex gap-2">
                                <button onclick="removePreference(@item.Dish.Id, this)" 
                                        class="flex-1 bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-2 px-3 rounded transition-colors">
                                    Remove
                                </button>
                                <a href="/swipe" class="flex-1 bg-purple-500 hover:bg-purple-600 text-white text-xs font-bold py-2 px-3 rounded text-center transition-colors">
                                    Rate Again
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <div class="text-6xl mb-4">👍</div>
                <h3 class="text-2xl font-bold text-gray-700 mb-2">No disliked dishes</h3>
                <p class="text-gray-600 mb-6">Great! You seem to like everything you've tried so far.</p>
                <a href="/swipe" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
                    Discover More Dishes
                </a>
            </div>
        }
    </div>

    <!-- Quick Actions -->
    <div class="mt-12 text-center">
        <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Want to discover more dishes?</h3>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/swipe" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition font-medium">
                    🔄 Continue Swiping
                </a>
                <button onclick="clearAllPreferences()" class="bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition font-medium">
                    🗑️ Clear All Preferences
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.tab-button.active {
    background-color: #8b5cf6;
    color: white;
}

.tab-button {
    background-color: transparent;
    color: #6b7280;
}

.line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

<script>
function showTab(tabName) {
    // Hide all tab content
    document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.add('hidden');
    });
    
    // Remove active class from all tab buttons
    document.querySelectorAll('.tab-button').forEach(button => {
        button.classList.remove('active');
    });
    
    // Show selected tab content
    document.getElementById(tabName + '-section').classList.remove('hidden');
    
    // Add active class to selected tab button
    document.getElementById(tabName + '-tab').classList.add('active');
}

async function removePreference(dishId, buttonElement) {
    if (!confirm('Are you sure you want to remove this preference?')) {
        return;
    }
    
    try {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenElement) {
            console.error('Anti-forgery token not found');
            alert('Error: Security token not found');
            return;
        }

        const formData = new FormData();
        formData.append('dishId', dishId);
        formData.append('__RequestVerificationToken', tokenElement.value);

        const response = await fetch('/Preferences?handler=RemovePreference', {
            method: 'POST',
            body: formData
        });

        if (response.ok) {
            const result = await response.json();
            if (result.success) {
                // Remove the dish card from the UI
                const dishCard = buttonElement.closest('[data-dish-id]');
                if (dishCard) {
                    dishCard.style.transition = 'opacity 0.3s ease-out, transform 0.3s ease-out';
                    dishCard.style.opacity = '0';
                    dishCard.style.transform = 'scale(0.95)';
                    
                    setTimeout(() => {
                        dishCard.remove();
                        
                        // Check if the section is now empty and update accordingly
                        updateEmptyStates();
                    }, 300);
                }
                
                console.log('Preference removed successfully');
            } else {
                console.error('Failed to remove preference:', result.message);
                alert('Failed to remove preference: ' + result.message);
            }
        } else {
            console.error('HTTP error:', response.status, response.statusText);
            alert('Error removing preference. Please try again.');
        }
    } catch (error) {
        console.error('Error removing preference:', error);
        alert('Error removing preference. Please try again.');
    }
}

function updateEmptyStates() {
    const likedSection = document.getElementById('liked-section');
    const dislikedSection = document.getElementById('disliked-section');
    
    // Check if liked section is empty
    const likedCards = likedSection.querySelectorAll('[data-dish-id]');
    if (likedCards.length === 0 && !likedSection.querySelector('.text-center')) {
        likedSection.innerHTML = `
            <div class="text-center py-12">
                <div class="text-6xl mb-4">😔</div>
                <h3 class="text-2xl font-bold text-gray-700 mb-2">No liked dishes yet</h3>
                <p class="text-gray-600 mb-6">Start swiping to find dishes you love!</p>
                <a href="/swipe" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
                    Start Swiping
                </a>
            </div>
        `;
    }
    
    // Check if disliked section is empty
    const dislikedCards = dislikedSection.querySelectorAll('[data-dish-id]');
    if (dislikedCards.length === 0 && !dislikedSection.querySelector('.text-center')) {
        dislikedSection.innerHTML = `
            <div class="text-center py-12">
                <div class="text-6xl mb-4">👍</div>
                <h3 class="text-2xl font-bold text-gray-700 mb-2">No disliked dishes</h3>
                <p class="text-gray-600 mb-6">Great! You seem to like everything you've tried so far.</p>
                <a href="/swipe" class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-700 transition">
                    Discover More Dishes
                </a>
            </div>
        `;
    }
    
    // Update tab counts
    updateTabCounts();
}

function updateTabCounts() {
    const likedCount = document.getElementById('liked-section').querySelectorAll('[data-dish-id]').length;
    const dislikedCount = document.getElementById('disliked-section').querySelectorAll('[data-dish-id]').length;
    
    document.getElementById('liked-tab').innerHTML = `❤️ Liked (${likedCount})`;
    document.getElementById('disliked-tab').innerHTML = `👎 Disliked (${dislikedCount})`;
}

async function clearAllPreferences() {
    if (!confirm('Are you sure you want to remove ALL your dish preferences? This action cannot be undone.')) {
        return;
    }
    
    const allRemoveButtons = document.querySelectorAll('[data-dish-id] button[onclick*="removePreference"]');
    let successCount = 0;
    let totalCount = allRemoveButtons.length;
    
    if (totalCount === 0) {
        alert('No preferences to remove.');
        return;
    }
    
    for (let button of allRemoveButtons) {
        const dishCard = button.closest('[data-dish-id]');
        const dishId = dishCard?.getAttribute('data-dish-id');
        
        if (dishId) {
            try {
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const formData = new FormData();
                formData.append('dishId', dishId);
                formData.append('__RequestVerificationToken', tokenElement.value);

                const response = await fetch('/Preferences?handler=RemovePreference', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        successCount++;
                        dishCard.style.opacity = '0';
                        dishCard.style.transform = 'scale(0.95)';
                    }
                }
            } catch (error) {
                console.error('Error removing preference for dish', dishId, error);
            }
        }
    }
    
    // Remove all cards after a delay
    setTimeout(() => {
        document.querySelectorAll('[data-dish-id]').forEach(card => card.remove());
        updateEmptyStates();
        alert(`Removed ${successCount} out of ${totalCount} preferences.`);
    }, 500);
}
</script>
