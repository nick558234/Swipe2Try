@page
@model Swipe2Try.Pages.RestaurantOwner.CreateModel
@{
	Layout = "_RestaurantOwnerLayout";
	ViewData["ActivePage"] = "MyDishes";
}

<div class="flex items-center justify-between">
	<h3 class="text-gray-700 text-3xl font-medium">Create New Dish</h3>
	<a asp-area="" asp-page="/RestaurantOwner/Index" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded">
		Cancel
	</a>
</div>

<div class="mt-8">
	<form method="post" class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
		<div asp-validation-summary="ModelOnly" class="text-red-500"></div>
		<div class="mb-4">
			<label asp-for="Dish.Name" class="block text-gray-700 text-sm font-bold mb-2">
				Dish Name *
			</label>
			<input asp-for="Dish.Name" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" placeholder="Enter dish name">
			<span asp-validation-for="Dish.Name" class="text-red-500 text-sm"></span>
		</div>

		<div class="mb-4">
			<label asp-for="Dish.Description" class="block text-gray-700 text-sm font-bold mb-2">
				Description *
			</label>
			<textarea asp-for="Dish.Description" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" rows="4" placeholder="Enter dish description"></textarea>
			<span asp-validation-for="Dish.Description" class="text-red-500 text-sm"></span>
		</div>

		<div class="mb-4">
			<label asp-for="Dish.HealthFactor" class="block text-gray-700 text-sm font-bold mb-2">
				Health Factor
			</label>
			<input asp-for="Dish.HealthFactor" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" placeholder="Enter health factor (optional)">
			<span asp-validation-for="Dish.HealthFactor" class="text-red-500 text-sm"></span>
		</div>

		<div class="mb-4">
			<label asp-for="Dish.Photo" class="block text-gray-700 text-sm font-bold mb-2">
				Photo URL
			</label>
			<input asp-for="Dish.Photo" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" placeholder="Enter image URL (optional)">
			<span asp-validation-for="Dish.Photo" class="text-red-500 text-sm"></span>
		</div>

		<div class="flex items-center justify-end mt-8">
			<button class="bg-orange-500 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">
				Create Dish
			</button>
		</div>
	</form>
</div>