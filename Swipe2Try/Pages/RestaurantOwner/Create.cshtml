@page
@model Swipe2Try.Pages.RestaurantOwner.CreateModel
@{
	Layout = "_RestaurantOwnerLayout";
	ViewData["ActivePage"] = "MyDishes";
}

<div class="flex items-center justify-between">
	<h3 class="text-gray-700 text-3xl font-medium">Create New Dish</h3>
	<a asp-page="/RestaurantOwner/Index" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded">
		Cancel
	</a>
</div>

@if (!ViewData.ModelState.IsValid || Model.ValidationErrors.Any())
{
    <div class="mt-4 bg-red-50 border border-red-200 text-red-800 rounded-md p-4">
        @if (Model.ValidationErrors.Any())
        {
            <ul class="list-disc list-inside">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }
        else
        {
            <div asp-validation-summary="All" class="text-red-600"></div>
        }
    </div>
}

<div class="mt-8">
	<form method="post" class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Dish Name -->
			<div class="mb-4">
				<label asp-for="Input.Name" class="block text-gray-700 text-sm font-bold mb-2">
					Dish Name *
				</label>
				<input asp-for="Input.Name" 
					   class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" 
					   placeholder="Enter dish name">
			</div>

			<!-- Health Factor -->
			<div class="mb-4">
				<label asp-for="Input.HealthFactor" class="block text-gray-700 text-sm font-bold mb-2">
					Health Factor
				</label>
				<input asp-for="Input.HealthFactor" 
					   class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" 
					   placeholder="e.g., High, Medium, Low">
			</div>

			<!-- Photo URL -->
			<div class="col-span-1 md:col-span-2 mb-4">
				<label asp-for="Input.Photo" class="block text-gray-700 text-sm font-bold mb-2">
					Photo URL
				</label>
				<input asp-for="Input.Photo" 
					   type="url"
					   class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" 
					   placeholder="https://example.com/image.jpg">
			</div>

			<!-- Description -->
			<div class="col-span-1 md:col-span-2 mb-4">
				<label asp-for="Input.Description" class="block text-gray-700 text-sm font-bold mb-2">
					Description *
				</label>
				<textarea asp-for="Input.Description" 
						  rows="4"
						  class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" 
						  placeholder="Enter dish description"></textarea>
			</div>
		</div>

		<div class="flex items-center justify-between mt-8">
			<button type="submit" 
					class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
				Create Dish
			</button>
			<a asp-page="/RestaurantOwner/Index" 
			   class="text-gray-600 hover:text-gray-800 font-medium">
				Cancel
			</a>
		</div>
	</form>
</div>