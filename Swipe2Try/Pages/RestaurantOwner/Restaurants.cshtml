@page "/RestaurantOwner/Restaurants"
@model Swipe2Try.Pages.RestaurantOwner.RestaurantsModel
@{
	Layout = "_RestaurantOwnerLayout";
	ViewData["ActivePage"] = "Restaurants";
	ViewData["Title"] = "My Restaurants";
}

<div class="flex items-center justify-between">
	<h3 class="text-gray-700 text-3xl font-medium">My Restaurants</h3>
	<a asp-page="/RestaurantOwner/CreateRestaurant" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded">
		Add Restaurant
	</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div class="mt-4 bg-green-50 border border-green-200 text-green-800 rounded-md p-4">
		@TempData["SuccessMessage"]
	</div>
}

@if (TempData["ErrorMessage"] != null)
{
	<div class="mt-4 bg-red-50 border border-red-200 text-red-800 rounded-md p-4">
		@TempData["ErrorMessage"]
	</div>
}

<div class="mt-8">
	@if (Model.Restaurants.Any())
	{
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			@foreach (var restaurant in Model.Restaurants)
			{
				<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
					<div class="p-6">
						<div class="flex justify-between items-start mb-4">
							<h4 class="text-xl font-semibold text-gray-800 truncate">@restaurant.Name</h4>
							<div class="flex space-x-2">
								<a asp-page="/RestaurantOwner/UpdateRestaurant" asp-route-id="@restaurant.Id"
								   class="text-blue-600 hover:text-blue-800 text-sm font-medium">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
									</svg>
								</a>
								<form asp-page-handler="Delete" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this restaurant?');">
									<input type="hidden" name="id" value="@restaurant.Id"/>
									<button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
										</svg>
									</button>
								</form>
							</div>
						</div>
						<div class="space-y-2">
							<div class="flex items-center text-gray-600">
								<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
								</svg>
								<span class="text-sm">@restaurant.Location</span>
							</div>
						</div>
					</div>
					<div class="bg-gray-50 px-6 py-3">
						<div class="flex justify-between items-center">
							<span class="text-xs text-gray-500">Restaurant ID: @restaurant.Id</span>
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
								Active
							</span>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="text-center py-12">
			<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
			</svg>
			<h3 class="mt-2 text-sm font-medium text-gray-900">No restaurants</h3>
			<p class="mt-1 text-sm text-gray-500">Get started by creating your first restaurant.</p>
			<div class="mt-6">
				<a asp-page="/RestaurantOwner/CreateRestaurant"
				   class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-orange-600 hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500">
					<svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
					New Restaurant
				</a>
			</div>
		</div>
	}
</div>