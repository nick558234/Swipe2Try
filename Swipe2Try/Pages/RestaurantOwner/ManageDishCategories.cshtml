@page
@model Swipe2Try.Pages.RestaurantOwner.ManageDishCategoriesModel
@{
    Layout = "_RestaurantOwnerLayout";
    ViewData["ActivePage"] = "ManageDishCategories";
    ViewData["Title"] = "Manage Dish Categories";
}

<div class="flex items-center justify-between mb-6">
    <h3 class="text-gray-700 text-3xl font-medium">Manage Dish Categories</h3>
    <a asp-area="" asp-page="/RestaurantOwner/Index" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded">
        Back to Dashboard
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 p-4 rounded-md @(Model.IsSuccess ? "bg-green-100 border-green-400 text-green-700" : "bg-red-100 border-red-400 text-red-700") border">
        @Model.Message
    </div>
}

<div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <h4 class="text-lg font-semibold text-gray-800">Your Dishes and Categories</h4>
        <p class="text-sm text-gray-600 mt-1">Assign categories to your dishes to help users find them easily</p>
    </div>

    @if (Model.Dishes.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dish</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Current Categories</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @for (int i = 0; i < Model.Dishes.Count; i++)
                    {
                        var dish = Model.Dishes[i];
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(dish.Photo))
                                    {
                                        <img class="h-10 w-10 rounded-full object-cover mr-4" src="@dish.Photo" alt="@dish.Name">
                                    }
                                    else
                                    {
                                        <div class="h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center mr-4">
                                            <span class="text-gray-500 text-xs">No Image</span>
                                        </div>
                                    }
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">@dish.Name</div>
                                        <div class="text-sm text-gray-500">@dish.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">
                                    @if (dish.Categories.Any())
                                    {
                                        @foreach (var category in dish.Categories)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mr-1 mb-1">
                                                @category.Name
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-500 italic">No categories assigned</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button type="button" class="text-blue-600 hover:text-blue-900" 
                                        onclick="openCategoryModal(@dish.Id, '@dish.Name')">
                                    Manage Categories
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-12 text-center">
            <div class="text-gray-500 text-lg">No dishes found</div>
            <p class="text-gray-400 mt-2">Create some dishes first to manage categories</p>
            <a asp-area="" asp-page="/RestaurantOwner/Create" class="mt-4 inline-block bg-orange-500 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded">
                Create New Dish
            </a>
        </div>
    }
</div>

<!-- Category Modal -->
<div id="categoryModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900 mb-4" id="modalTitle">Manage Categories</h3>            <form method="post" id="categoryForm">
                <input type="hidden" name="SelectedDishId" id="modalDishId" />
                <div class="space-y-2 max-h-60 overflow-y-auto">
                    @foreach (var category in Model.AllCategories)
                    {
                        <div class="flex items-center">
                            <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" 
                                   class="category-checkbox h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300 rounded">
                            <label class="ml-2 text-sm text-gray-700">@category.Name</label>
                        </div>
                    }
                </div>
                <div class="flex justify-end mt-4 space-x-2">
                    <button type="button" onclick="closeCategoryModal()" 
                            class="bg-gray-300 hover:bg-gray-400 text-gray-700 font-bold py-2 px-4 rounded">
                        Cancel
                    </button>                    <button type="submit"
                            class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        Save Categories
                    </button>
                </div>
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>

<script>
async function openCategoryModal(dishId, dishName) {
    document.getElementById('modalDishId').value = dishId;
    document.getElementById('modalTitle').textContent = `Manage Categories for ${dishName}`;
    
    // Clear all checkboxes first
    const checkboxes = document.querySelectorAll('.category-checkbox');
    checkboxes.forEach(cb => cb.checked = false);
    
    // Load existing categories for this dish
    try {
        const response = await fetch(`/RestaurantOwner/ManageDishCategories?handler=DishCategories&dishId=${dishId}`);
        if (response.ok) {
            const categoryIds = await response.json();
            categoryIds.forEach(id => {
                const checkbox = document.querySelector(`.category-checkbox[value="${id}"]`);
                if (checkbox) {
                    checkbox.checked = true;
                }
            });
        }
    } catch (error) {
        console.error('Error loading dish categories:', error);
    }
    
    document.getElementById('categoryModal').classList.remove('hidden');
}

function closeCategoryModal() {
    document.getElementById('categoryModal').classList.add('hidden');
}

// Close modal when clicking outside
document.getElementById('categoryModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeCategoryModal();
    }
});
</script>
