<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"] - Swipe 2 Try Admin</title>
	<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
<div class="min-h-screen flex flex-col">
	<!-- Sidebar -->
	<div class="flex flex-col md:flex-row flex-1">
		<aside class="bg-purple-700 w-full md:w-64 md:min-h-screen">
			<div class="flex items-center justify-center h-16 bg-purple-800">
				<span class="text-white font-bold text-lg">Swipe 2 Try Admin</span>
			</div>

			<!-- User Info Section -->
			<div class="px-6 py-4 border-b border-purple-600">
				<partial name="_UserInfoPartial"/>
			</div>

			<nav class="mt-10">
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Dashboard" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Index">
					<span class="mx-3">Dashboard</span>
				</a>
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Restaurants" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Restaurants">
					<span class="mx-3">Restaurants</span>
				</a>
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Dishes" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Dishes/Index">
					<span class="mx-3">Dishes</span>
				</a>
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Categories" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Categories/Index">
					<span class="mx-3">Categories</span>
				</a>
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Users" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Users/Index">
					<span class="mx-3">Users</span>
				</a>
				<a class="flex items-center mt-4 py-2 px-6 rounded-md text-white @(ViewData["ActivePage"] as string == "Settings" ? "bg-purple-800 font-semibold" : "hover:bg-purple-700")" asp-page="/Admin/Settings/Index">
					<span class="mx-3">Settings</span>
				</a>
			</nav>
		</aside>

		<!-- Main Content -->
		<main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100">
			<div class="container mx-auto px-6 py-8">
				@RenderBody()
			</div>
		</main>
	</div>
</div>
</body>
</html>