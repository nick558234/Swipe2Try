@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
	var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Guest";
	var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "Unknown";
}

<div class="flex items-center">
	<div class="relative">
		<div class="flex items-center space-x-3">
			<div class="bg-purple-200 rounded-full h-8 w-8 flex items-center justify-center">
				<span class="text-purple-800 font-semibold">@(userName.Length > 0 ? userName[0] : 'G')</span>
			</div>
			<div>
				<p class="text-white text-sm font-medium">@userName</p>
				<p class="text-purple-200 text-xs">@userRole</p>
			</div>
		</div>
	</div>
</div>