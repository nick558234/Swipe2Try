sequenceDiagram
    autonumber
    actor User
    participant AC as AuthenticationController
    participant UM as UserManager
    participant TS as TokenService
    
    User->>+AC: Login(username, password)
    AC->>+UM: ValidateCredentials(username, password)
    alt Valid Credentials
        UM-->>-AC: return User Object
        AC->>+TS: GenerateToken(user)
        TS-->>-AC: return JWT Token
        AC-->>-User: return {token, success: true}
    else Invalid Credentials
        UM-->>-AC: return null
        AC-->>-User: return {error: "Invalid credentials", success: false}
    end
    
    note over User,TS: Authentication Flow Completed
